# Base URL of the Cloudflare Worker API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8787

# Social links shown in the footer
VITE_YOUTUBE_URL=https://youtube.com/@your-channel
VITE_INSTAGRAM_URL=https://instagram.com/your-handle

# Public site URL (used for canonical / og tags)
VITE_SITE_URL=http://localhost:5173

# Push notifications (Phase 3) - PUBLIC Firebase web-app settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
